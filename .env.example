# ===================================================
# JADWALKU - ENVIRONMENT VARIABLES CONFIGURATION
# ===================================================

# 1. Google Gemini AI API Key (Optional)
# AI Studio automatically injects this. On Vercel, add if using server-side Gemini features.
GEMINI_API_KEY=""

# 2. Host Application URL
# Cloud Run or Vercel production URL (e.g., https://your-app.vercel.app)
APP_URL=""

# 3. Firebase & Google Calendar OAuth Integration (Optional)
# If provided, enables 2-way Google Calendar synchronization.
# If omitted, JadwalKu runs 100% offline with local storage & .ics calendar file export.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
